# Copy to .env and fill in for local development.

# --- Database (local Postgres, no Docker) ---
DATABASE_URL=postgresql+asyncpg://hfmg:hfmg_dev_local@localhost:5432/hfmg_helpdesk

# --- CORS (Vite dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- Email notifications ---
# Leave SMTP_HOST unset to run in "log-only" mode: emails are logged instead of sent,
# so the app works end-to-end without a mail server configured.
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=helpdesk-noreply@hfmg.net
HELPDESK_NOTIFICATION_EMAIL=helpdesk@hfmg.net

# --- AI summary (optional, off by default) ---
ENABLE_AI_SUMMARY=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
