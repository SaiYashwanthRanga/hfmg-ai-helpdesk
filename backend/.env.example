# Copy to .env and fill in for local development.

# --- Database (local Postgres, no Docker) ---
DATABASE_URL=postgresql+asyncpg://hfmg:hfmg_dev_local@localhost:5432/hfmg_helpdesk

# --- CORS (Vite dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- Email notifications (Twilio SendGrid, via its API -- not SMTP) ---
# Without SENDGRID_API_KEY set, sends are skipped (logged, no content) rather
# than dumping ticket details to the log -- the app still runs end-to-end.
ENABLE_EMAIL_NOTIFICATIONS=true
# EMAIL_PROVIDER is "sendgrid" or "hfmg_internal" (the HFMG internal mail API,
# see EMAIL_INTEGRATION.md).
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
# Used when EMAIL_PROVIDER=hfmg_internal. ORG_BASE is the mail API's base URL;
# DEFAULT_FROM_EMAIL is the mailbox it sends as (overrides EMAIL_FROM).
ORG_BASE=
DEFAULT_FROM_EMAIL=
# Every notification is sent from EMAIL_FROM to HELPDESK_EMAIL -- fixed, not
# configurable per ticket.
EMAIL_FROM=reminder@hfmg.net
HELPDESK_EMAIL=helpdesk@hfmg.net

# --- LLM provider ---
# Powers AI ticket summaries and the voice agent's understanding of callers.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
# Optional: point at a compatible gateway/proxy instead of api.openai.com.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2000
# Both are omitted from requests unless set here. Reasoning models (the gpt-5
# family) REJECT `temperature` -- leave it blank for those. Set it only for a
# model that supports it.
OPENAI_TEMPERATURE=
# Optional, for reasoning models: minimal | low | medium | high. Left empty, the
# original gpt-5 family (gpt-5, -mini, -nano) defaults to "minimal"; a higher value
# can exhaust OPENAI_MAX_OUTPUT_TOKENS on hidden reasoning and return no text.
# "minimal" gives the fastest response, which matters on voice calls.
OPENAI_REASONING_EFFORT=

# --- AI summary (optional, off by default) ---
ENABLE_AI_SUMMARY=false

# --- Voice agent (SIP: Nextiva -> SIPSorcery gateway -> this backend) ---
VOICE_LANGUAGE=en-US
# Model for the voice agent's understanding (a caller waits on every call).
# Separate from OPENAI_MODEL (AI summaries). Empty = use OPENAI_MODEL.
VOICE_NLU_MODEL=gpt-4.1-mini
# If a voice NLU call hasn't answered after this many seconds, send an
# identical second request and use whichever answers first (0 disables).
VOICE_NLU_HEDGE_AFTER_SECONDS=2.5
# Read the caller's name back spelled when confidence in it is low (an
# unfamiliar name, or low recognizer confidence); a "no" lets them spell it and
# the corrected name is read back again. Common names cost no extra turn.
VOICE_CONFIRM_NAME=true
# Read the whole ticket back (who, what, since when, priority and why) and let
# the caller correct it before it is created. One extra turn per call.
VOICE_CONFIRM_SUMMARY=true
# Callback-number attempts before the agent carries on without one.
VOICE_MAX_PHONE_ATTEMPTS=2
# HFMG's departments, comma-separated. What a caller says is matched against
# this list; anything else is read back and marked "unverified" on the ticket.
# Empty = a PLACEHOLDER list in app/voice/departments.py -- set the real one.
VOICE_DEPARTMENTS=
# The voice agent needs OPENAI_API_KEY set to understand callers, and reuses
# the same provider/model as the AI summary feature above.

# --- Database pool (shared by the whole API) ---
# Each voice turn holds a connection for its NLU round trip, so concurrent
# turns beyond pool + overflow queue. See docs/reviews/VOICE_SIMULATOR_PERFORMANCE.md.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- AI Call Simulator (VOICE_SIMULATOR.md) ---
# Browser-based test calls to the voice agent. Off by default. The API has no
# auth, so enabling it lets anyone who can reach the API spend OpenAI credit.
# Refused at startup when ENVIRONMENT=production.
ENVIRONMENT=development
ENABLE_VOICE_SIMULATOR=false
# Let a session opt in to the real "ticket created" email. Keep false unless
# you are testing the email itself.
SIMULATOR_ALLOW_NOTIFICATIONS=false
SIMULATOR_MAX_CONCURRENT_SESSIONS=30
SIMULATOR_MAX_SESSIONS_PER_HOUR=300
SIMULATOR_MAX_TURNS_PER_SESSION=40
SIMULATOR_MAX_AUDIO_BYTES=2000000
SIMULATOR_SESSION_IDLE_TIMEOUT_SECONDS=600
# purge_simulator_data.py deletes simulator sessions and tickets older than this.
SIMULATOR_RETENTION_DAYS=14
# Speech for the simulator only (on the phone path the SIP gateway does its own STT/TTS).
SPEECH_PROVIDER=openai
SPEECH_STT_MODEL=gpt-4o-mini-transcribe
SPEECH_TTS_MODEL=tts-1
SPEECH_TTS_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=10
SPEECH_TTS_FORMAT=mp3
# Bias transcription with HFMG vocabulary and the expected answer shape.
SPEECH_STT_CONTEXT=true
# Transcriber for spelling turns (email, name corrections) and for anything
# that came back in a non-English script. whisper-1 keeps spelled letters
# literal; the default transcriber merges them into words.
SPEECH_STT_SPELLING_MODEL=whisper-1
# Synthesized replies kept in memory by exact text (0 disables).
SPEECH_TTS_CACHE_ENTRIES=256
# LLM_PROVIDER=fake answers with keyword rules after this delay -- for load
# tests and demos without an API key. Ignored in production.
FAKE_LLM_LATENCY_MS=300

# --- SIP voice gateway (SipVoiceGateway / Sorcery) ---
# Shared secret the gateway sends as "Authorization: Bearer <token>" to
# /api/v1/voice/sip/*. Must match Backend.GatewayToken in the gateway's
# appsettings.json. Leave blank to disable the SIP endpoints.
VOICE_SIP_GATEWAY_TOKEN=
